interface exchange
service GetExchangeRates (
    input {
        String baseCurrency {
            required: false;
        };
        String targetCurrency {
            required: false;
        };
    }
    output {
        recordList exchangeRates {
            allowUnspecifiedFields: true;
        };
    }
)
properties {
    comment: "This service retrieves a list of current foreign exchange rates relative to a specified anchor currency, defaulting to USD if no base currency is provided. It allows users to optionally filter the results down to a single destination currency or return the entire collection of available currency pairs. The resulting data set is returned as a structured document list designed for seamless downstream mapping and conversions.";
    favorite: false;
    deprecated: false;
    visible: private;
    reuse: private;
    stateless: true;
    cacheResults: false;
    cacheExpire: 15;
    prefetch: false;
    prefetchActivation: 1;
    pipelineDebug: None;
    allowedHttpMethods: [TRACE, HEAD, DELETE, POST, GET, OPTIONS, PUT, PATCH];
    maxRetryAttempts: 0;
    retryInterval: 0;
    enableAuditing: never;
    logOn: Error only;
    includePipeline: never;
    circuitBreakerEnabled: false;
    failureEvent: Exception only;
    timeoutPeriod: 60;
    cancelThreadOnTimeout: false;
    failureThreshold: 5;
    failurePeriod: 60;
    circuitOpenAction: Throw exception;
    circuitResetPeriod: 300;
    concurrencyEnabled: false;
    maxConcurrentRequests: 20;
    validateInput: false;
    validateOutput: false;
}
{
    IF (baseCurrency == $null) {
        MAP {
            mapTarget {
                String baseCurrency;
            }
            set `baseCurrency` = "USD";
        }
    }
    MAP {
        mapTarget {
            String baseUrl;
        }
        set `baseUrl` = "https://api.frankfurter.dev/v2/rates";
    }
    MAP {
        TRANSFORM pub.string:concat {
            invoke-order: 0
            validateInput: false
            validateOutput: false
            input {
                mapSource {
                    String baseUrl;
                }
                mapTarget {
                    String inString1;
                    String inString2;
                }
                copy baseUrl -> inString1;
                set (variable) `inString2` = "?base=%baseCurrency%";
            }
            output {
                mapSource {
                    String value;
                }
                mapTarget {
                    String baseUrl;
                }
                copy value -> baseUrl;
            }
        }
    }
    IF (targetCurrency != $null) {
        MAP {
            TRANSFORM pub.string:concat {
                invoke-order: 0
                validateInput: false
                validateOutput: false
                input {
                    mapSource {
                        String baseUrl;
                    }
                    mapTarget {
                        String inString1;
                        String inString2;
                    }
                    copy baseUrl -> inString1;
                    set (variable) `inString2` = "&quotes=%targetCurrency%";
                }
                output {
                    mapSource {
                        String value;
                    }
                    mapTarget {
                        String baseUrl;
                    }
                    copy value -> baseUrl;
                }
            }
        }
    }
    INVOKE pub.client:http {
        validateInput: false
        validateOutput: false
        input {
            mapSource {
                String baseUrl;
            }
            mapTarget {
                String url;
                String method;
            }
            copy baseUrl -> url;
            set `method` = "get";
        }
    }
    INVOKE pub.string:bytesToString {
        validateInput: false
        validateOutput: false
        input {
            mapSource {
                record body;
            }
            mapTarget {
                Object bytes;
            }
            copy `body/bytes` -> bytes;
        }
        output {
            mapSource {
                String string;
            }
            mapTarget {
                String `output`;
            }
            copy string -> output;
        }
    }
    INVOKE pub.json:jsonStringToDocument {
        validateInput: false
        validateOutput: false
        input {
            mapSource {
                String `output`;
            }
            mapTarget {
                String jsonString;
            }
            copy output -> jsonString;
        }
        output {
            mapSource {
                record document {
                    allowUnspecifiedFields: true;
                };
            }
            mapTarget {
                recordList exchangeRates {
                    allowUnspecifiedFields: true;
                };
            }
            copy document -> exchangeRates;
            drop `jsonString`;
            drop `bytes`;
            drop `url`;
            drop `method`;
            drop `output`;
            drop `baseUrl`;
            drop `encodedURL`;
            drop `header`;
            drop `body`;
            drop `string`;
            drop `document`;
        }
    }
}
